name: build
on: workflow_dispatch
permissions:
  contents: read
  pages: write
  id-token: write
jobs:
  build:
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: pip install pygbag
      - run: |
          mkdir game
          cp "$(ls *.py | head -n1)" game/main.py
          cp *.ogg *.mp3 *.wav game/ 2>/dev/null || true
      - run: python -m pygbag --build game
      - uses: actions/upload-pages-artifact@v3
        with:
          path: game/build/web
      - id: deployment
        uses: actions/deploy-pages@v4
